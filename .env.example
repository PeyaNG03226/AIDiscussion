# 复制为 .env 后填写（.env 不会提交到仓库）

# 运行配置
AIDISCUSSION_DEBUG=false
AIDISCUSSION_LOG_LEVEL=INFO
AIDISCUSSION_DATA_DIR=./data

# 数据库：留空则自动使用 ./data/aidiscussion.db
# AIDISCUSSION_DATABASE_URL=sqlite+aiosqlite:///./data/aidiscussion.db

# 模型配置：任何 OpenAI 兼容接口都适用
# DeepSeek: https://api.deepseek.com/v1
# 通义百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama 本地: http://localhost:11434/v1
AIDISCUSSION_LLM_API_KEY=
AIDISCUSSION_LLM_BASE_URL=https://api.deepseek.com/v1
AIDISCUSSION_LLM_MODEL=deepseek-chat
AIDISCUSSION_LLM_TIMEOUT=60
AIDISCUSSION_LLM_MAX_RETRIES=2
