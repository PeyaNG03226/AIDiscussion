# 复制为 .env 后填写（.env 不会提交到仓库）

# 运行配置
AIDISCUSSION_DEBUG=false
AIDISCUSSION_LOG_LEVEL=INFO
AIDISCUSSION_DATA_DIR=./data

# 数据库：留空则自动使用 ./data/aidiscussion.db
# AIDISCUSSION_DATABASE_URL=sqlite+aiosqlite:///./data/aidiscussion.db

# 模型配置：任何 OpenAI 兼容接口都适用
# 这一组是「默认厂商」的配置，DeepSeek 成员默认用它
# DeepSeek: https://api.deepseek.com/v1
# 通义百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama 本地: http://localhost:11434/v1
AIDISCUSSION_LLM_API_KEY=
AIDISCUSSION_LLM_BASE_URL=https://api.deepseek.com/v1
AIDISCUSSION_LLM_MODEL=deepseek-chat
AIDISCUSSION_LLM_TIMEOUT=60
AIDISCUSSION_LLM_MAX_RETRIES=2

# 多厂商：每个 AI 成员绑定一个厂商，密钥分开配置
# 填了哪个厂商的 Key，那个厂商的成员就用真实模型；没填的会回退到离线 Mock
# 火山方舟（豆包）：https://console.volcengine.com/ark
# 模型名各账号权限不同，报「模型不存在」时用 /api/v3/models 查你账号可用的 id
AIDISCUSSION_DOUBAO_API_KEY=
AIDISCUSSION_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AIDISCUSSION_DOUBAO_MODEL=doubao-seed-character-251128

# 月之暗面（Kimi）：https://platform.moonshot.cn
AIDISCUSSION_KIMI_API_KEY=
AIDISCUSSION_KIMI_BASE_URL=https://api.moonshot.cn/v1
AIDISCUSSION_KIMI_MODEL=kimi-k2.6

# 深度求索（DeepSeek）：留空则复用上面的 AIDISCUSSION_LLM_*
# AIDISCUSSION_DEEPSEEK_API_KEY=
# AIDISCUSSION_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# AIDISCUSSION_DEEPSEEK_MODEL=deepseek-chat

# 阿里百炼（通义千问）：https://bailian.console.aliyun.com
AIDISCUSSION_QWEN_API_KEY=
AIDISCUSSION_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AIDISCUSSION_QWEN_MODEL=qwen3.8-flash

# Web 服务
AIDISCUSSION_API_HOST=127.0.0.1
AIDISCUSSION_API_PORT=8000

# 上下文压缩：超过预算后把更早的消息压成摘要，最近 N 条始终保留原文
AIDISCUSSION_CONTEXT_MAX_TOKENS=2400
AIDISCUSSION_CONTEXT_KEEP_RECENT=12

# 长期记忆：从用户消息中提取跨会话事实，并召回最相关的若干条
AIDISCUSSION_MEMORY_ENABLED=true
AIDISCUSSION_MEMORY_TOP_K=5
